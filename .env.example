# Порт, на котором слушает ваше Node.js приложение внутри контейнера app
APP_PORT=8085

# Внутренний HTTPS-порт Nginx.
# Именно на него Xray делает fallback через target=127.0.0.1:9443
NGINX_HTTPS_PORT=9443

# Адрес, на котором HTTPS-сервер Nginx принимает соединения (по умолчанию 0.0.0.0).
# Нужен при network_mode: host, чтобы не слушать публичный интерфейс.
# NGINX_LISTEN_HOST=127.0.0.1

# Необязательно: unix-сокет с PROXY protocol для Xray Reality target (xver=1); nginx берёт из него IP клиента.
# Каталог сокета монтируется через docker-compose.override.yml: root:root 0700 с файлом .frontend.lock (root:root 0600).
# NGINX_PROXY_SOCKET=/run/xray-proxy/cover.sock

# Домен вашего сайта
SITE_DOMAIN=example.com

# Точный путь XHTTP, который сайт маскирует фирменной страницей 403
XHTTP_PATH=/replace-with-private-path

# События демонстрационных форм для Mosquito Swatter. Укажите внешний origin без пути.
REMOVI_SWATTER_EVENTS=0
# Независимый web audit (итоговый HTTP-статус); использует те же origin/proxy/log настройки.
REMOVI_SWATTER_WEB_AUDIT=0
REMOVI_PUBLIC_ORIGIN=
# Несколько точных origins; если задано, заменяет REMOVI_PUBLIC_ORIGIN.
# REMOVI_PUBLIC_ORIGINS=https://example.com,https://example.com:7443
# REMOVI_INSTANCE_ID=videohub
# 1 = брать IP клиента из последнего адреса X-Forwarded-For, если запрос пришёл от прокси из частной сети (nginx, Caddy)
REMOVI_TRUST_PROXY=0
# Точные IP непосредственных прокси (без CIDR); закрепите их при пересоздании контейнеров.
# REMOVI_TRUSTED_PROXY_IPS=172.19.0.2
# Уже созданный абсолютный каталог: события в events.jsonl вместо stdout, 3 файла по 10 MiB.
# REMOVI_SWATTER_LOG_DIR=/events

# Пути на хосте к TLS-сертификату и приватному ключу
CERT_FULLCHAIN_PATH=/home/user/certs/fullchain.pem
CERT_PRIVKEY_PATH=/home/user/certs/privkey.pem
